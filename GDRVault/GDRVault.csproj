<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<ApplicationIcon>GDRVault.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="GDRVault.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="GDRVault.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDRVault.Core\GDRVault.Core.csproj" />
    <ProjectReference Include="..\GDRVault.Security\GDRVault.Security.csproj" />
    <ProjectReference Include="..\GDRVault.Storage\GDRVault.Storage.csproj" />
  </ItemGroup>

</Project>
