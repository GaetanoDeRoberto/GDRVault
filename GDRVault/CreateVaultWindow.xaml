<Window x:Class="GDRVault.CreateVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea nuovo Vault"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="CreateVaultPasswordBox"
               TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#8B6FF5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder"
                                        Property="BorderBrush"
                                        Value="#514A68"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder"
                                        Property="BorderBrush"
                                        Value="#8B6FF5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateVaultPrimaryButton"
               TargetType="{x:Type Button}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#8B6FF5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#9B82FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#7355D6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#9B82FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateVaultSecondaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CreateVaultPrimaryButton}">
            <Setter Property="Background" Value="#2A2D36"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353946"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#22242B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="#101114">

        <Border Margin="35"
                Padding="35"
                Background="#191B20"
                CornerRadius="22">

            <StackPanel>

                <TextBlock Text="Crea Nuovo Vault"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Proteggi le tue password con una Master Password."
                           Foreground="#9EA4B4"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="20,0,20,35"/>

                <TextBlock Text="Master Password"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="MasterPasswordBox"
                             Foreground="White"
                             Height="48"
                             FontSize="18"
                             Padding="12"
                             Margin="0,0,0,22" Background="#FF101114" BorderBrush="#FF30333D" SelectionBrush="#FF8B6FF5"/>

                <TextBlock Text="Conferma Master Password"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="ConfirmPasswordBox"
                             Foreground="White"
                             Height="48"
                             FontSize="18"
                             Padding="12"
                             Margin="0,0,0,30" Background="#FF101114" BorderBrush="#FF30333D" SelectionBrush="#FF8B6FF5"/>

                <Button Content="Crea Vault"
                        Height="55"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Click="CreateButton_Click"
                        Background="#8975F2"
                        Foreground="White"
                        BorderThickness="0"/>
                

                <Button Content="Annulla"
                        Height="45"
                        Margin="0,12,0,0"
                        FontSize="15"
                        Click="CancelButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>