<Window x:Class="GDRVault.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GDRVault"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#101114">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- PULSANTE PRINCIPALE -->
        <!-- ================================================= -->

        <Style x:Key="VaultPrimaryButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#8B6FF5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#9B82FF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#7659DD"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- PULSANTE SECONDARIO -->
        <!-- ================================================= -->

        <Style x:Key="VaultSecondaryButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#E5E7EB"/>

            <Setter Property="Background"
                    Value="#22252C"/>

            <Setter Property="BorderBrush"
                    Value="#353944"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2D3039"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#4A4F5C"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1B1E24"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- PULSANTE AZIONE VIOLA -->
        <!-- ================================================= -->

        <Style x:Key="VaultActionButton"
               TargetType="Button"
               BasedOn="{StaticResource VaultPrimaryButton}">
            <Setter Property="Height" Value="40"/>
        </Style>


        <!-- ================================================= -->
        <!-- SCROLLBAR - STILE GDRVAULT -->
        <!-- ================================================= -->

        <Style x:Key="VaultScrollBar"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="#5D606A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#101114"
                              Width="10">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Focusable="False">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"
                                                        BorderThickness="0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Background="#5D606A"
                                           Margin="1,1,1,1"
                                           MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"
                                                        BorderThickness="0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="#8B6FF5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ================================================= -->
        <!-- COMBOBOX - STILE GDRVAULT -->
        <!-- ================================================= -->

        <Style x:Key="VaultComboBoxItem"
       TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#191B20"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">

                            <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#29223F"/>
                                <Setter Property="Foreground"
                                Value="#B59CFF"/>
                            </Trigger>

                            <!-- SELEZIONATO -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#8B6FF5"/>
                                <Setter Property="Foreground"
                                Value="White"/>
                            </Trigger>

                            <!-- DISABILITATO -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity"
                                Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ================================================= -->
        <!-- COMBOBOX PRINCIPALE -->
        <!-- ================================================= -->

        <Style x:Key="VaultComboBox"
       TargetType="{x:Type ComboBox}">

            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#191B20"/>
            <Setter Property="BorderBrush" Value="#353944"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle"
            Value="{StaticResource VaultComboBoxItem}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <!-- CORPO COMBOBOX -->
                            <Border x:Name="ComboBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- TESTO SELEZIONATO -->
                                    <ContentPresenter
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                    <!-- FRECCIA -->
                                    <Border Grid.Column="1"
                                    Background="Transparent">

                                        <Path
                                    x:Name="Arrow"
                                    Width="10"
                                    Height="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="#A78BFA"
                                    Data="M 0 0 L 10 0 L 5 6 Z"/>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- POPUP -->
                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           PopupAnimation="Fade"
                           StaysOpen="False">

                                <Border
                            Margin="0,5,0,0"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="#191B20"
                            BorderBrush="#353944"
                            BorderThickness="1"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">

                                    <ScrollViewer
                                MaxHeight="280"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="{x:Type ScrollBar}"
                                                   BasedOn="{StaticResource VaultScrollBar}"/>
                                        </ScrollViewer.Resources>

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <!-- HOVER COMBOBOX -->
                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#514A68"/>

                            </Trigger>


                            <!-- APERTA -->
                            <Trigger Property="IsDropDownOpen"
                             Value="True">

                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#8B6FF5"/>

                            </Trigger>


                            <!-- DISABILITATA -->
                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="ComboBorder"
                                Property="Opacity"
                                Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- CONTENITORE PRINCIPALE -->
    <!-- ===================================================== -->

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="GDRVault"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Vault sbloccato"
                           FontSize="14"
                           Foreground="#9FA4B2"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="Blocca Vault"
                    Width="120"
                    Height="40"
                    Style="{StaticResource VaultActionButton}"
                    Click="LockButton_Click"/>

        </Grid>


        <!-- ================================================= -->
        <!-- CONTENUTO -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="#191B20"
                CornerRadius="14"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TITOLO + NUOVA CREDENZIALE -->
                <!-- ================================================= -->

                <DockPanel Grid.Row="0">

                    <TextBlock Text="Le tue credenziali"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>


                    <Button Content="+  Nuova credenziale"
                            Width="180"
                            Height="40"
                            DockPanel.Dock="Right"
                            Style="{StaticResource VaultPrimaryButton}"
                            Click="NewEntryButton_Click" HorizontalAlignment="Right"/>

                </DockPanel>


                <!-- ================================================= -->
                <!-- RICERCA E FILTRI -->
                <!-- ================================================= -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="120"/>

                    </Grid.ColumnDefinitions>


                    <!-- RICERCA -->

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Height="48"
                             FontSize="15"
                             Padding="12,0"
                             Background="#101114"
                             Foreground="White"
                             BorderBrush="#30333C"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             SelectionBrush="#8B6FF5"
                             CaretBrush="#8B6FF5">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="SearchBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Background="#101114"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SearchBorder"
                                                Property="BorderBrush"
                                                Value="#514A68"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="SearchBorder"
                                                Property="BorderBrush"
                                                Value="#8B6FF5"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="SearchBorder"
                                                Property="Opacity"
                                                Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>


                    <!-- ================================================= -->
                    <!-- CATEGORIE -->
                    <!-- ================================================= -->

                    <ComboBox x:Name="CategoryFilterBox"
          Grid.Column="1"
          Height="48"
          Width="200"
          Margin="10,0,16,0"
          Style="{StaticResource VaultComboBox}"
          SelectionChanged="CategoryFilterBox_SelectionChanged"
          PreviewMouseLeftButtonDown="CategoryFilterBox_PreviewMouseLeftButtonDown">

                        <ComboBoxItem Content="Tutte le categorie"
                  IsSelected="True"/>

                    </ComboBox>


                    <!-- ================================================= -->
                    <!-- PREFERITI -->
                    <!-- ================================================= -->

                    <Button x:Name="FavoritesButton"
                            Grid.Column="2"
                            Content="☆ Preferiti"
                            Height="38"
                            Margin="10,0,0,0"
                            Style="{StaticResource VaultActionButton}"
                            Click="FavoritesButton_Click"/>

                </Grid>


                <!-- ================================================= -->
                <!-- LISTA CREDENZIALI -->
                <!-- ================================================= -->

                <ListBox x:Name="EntriesList"
                         Grid.Row="4"
                         Background="#101114"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="EntriesList_SelectionChanged">

                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource VaultScrollBar}"/>
                    </ListBox.Resources>


                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="Padding"
                                    Value="0"/>

                            <Setter Property="Margin"
                                    Value="0,0,0,8"/>

                            <Setter Property="Background"
                                    Value="Transparent"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>


                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10">

                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                        </Border>


                                        <ControlTemplate.Triggers>

                                            <!-- HOVER -->

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="ItemBorder"
                                                        Property="Background"
                                                        Value="#22252D"/>

                                            </Trigger>


                                            <!-- SELEZIONATO -->

                                            <Trigger Property="IsSelected"
                                                     Value="True">

                                                <Setter TargetName="ItemBorder"
                                                        Property="Background"
                                                        Value="#29263A"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.ItemContainerStyle>


                    <!-- ================================================= -->
                    <!-- TEMPLATE CREDENZIALE -->
                    <!-- ================================================= -->

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="16"
                                    Background="#191B20"
                                    CornerRadius="10">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="35"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- ================================================= -->
                                    <!-- ICONA -->
                                    <!-- ================================================= -->

                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="21"
                                            Background="#29223F"
                                            VerticalAlignment="Center">

                                        <Viewbox Width="20"
                                                 Height="20"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24"
                                                    Height="24">
                                                <Path Fill="#A78BFA"
                                                      Data="M17,8H16V6C16,3.79 14.21,2 12,2C9.79,2 8,3.79 8,6V8H7C5.9,8 5,8.9 5,10V20C5,21.1 5.9,22 7,22H17C18.1,22 19,21.1 19,20V10C19,8.9 18.1,8 17,8M10,6C10,4.9 10.9,4 12,4C13.1,4 14,4.9 14,6V8H10V6M17,20H7V10H17V20M12,12C10.9,12 10,12.9 10,14C10,14.74 10.4,15.39 11,15.73V18H13V15.73C13.6,15.39 14,14.74 14,14C14,12.9 13.1,12 12,12Z"/>
                                            </Canvas>
                                        </Viewbox>

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- INFORMAZIONI -->
                                    <!-- ================================================= -->

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,20,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="13"
                                                   Foreground="#9FA4B2"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>


                                    <!-- ================================================= -->
                                    <!-- CATEGORIA -->
                                    <!-- ================================================= -->

                                    <Border Grid.Column="2"
                                            Background="#242832"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="#B8BDCA"
                                                   FontSize="12"/>

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- PREFERITO -->
                                    <!-- ================================================= -->

                                    <TextBlock Grid.Column="3"
                                               FontSize="20"
                                               Foreground="#FFD54A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text"
                                                        Value="☆"/>

                                                <Setter Property="Opacity"
                                                        Value="0.35"/>


                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsFavorite}"
                                                                 Value="True">

                                                        <Setter Property="Text"
                                                                Value="★"/>

                                                        <Setter Property="Opacity"
                                                                Value="1"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <TextBlock Grid.Column="0"
                       Text="{Binding EntryCountText}"
                       Foreground="#777C89"
                       VerticalAlignment="Center"/>


            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">


                <!-- RIPRISTINA -->

                <Button Content="Ripristina"
                        Width="100"
                        Height="48"
                        Margin="0,0,10,0"
                        Style="{StaticResource VaultActionButton}"
                        Click="RestoreButton_Click"/>


                <!-- BACKUP -->

                <Button Content="Backup"
                        Width="100"
                        Height="48"
                        Margin="0,0,10,0"
                        Style="{StaticResource VaultActionButton}"
                        Click="BackupButton_Click"/>


                <!-- CAMBIA PASSWORD -->

                <Button Content="Cambia password"
                        Width="140"
                        Height="48"
                        Margin="0,0,10,0"
                        Style="{StaticResource VaultPrimaryButton}"
                        Click="ChangeMasterPasswordButton_Click"/>


                <!-- SALVA -->

                <Button Content="Salva"
                        Width="100"
                        Height="48"
                        Style="{StaticResource VaultPrimaryButton}"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>