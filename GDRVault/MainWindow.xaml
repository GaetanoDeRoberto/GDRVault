<Window x:Class="GDRVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GDRVault"
        Width="900"
        Height="600"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#101114">

    <Window.Resources>

        <!-- Colori -->
        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#101114"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#181A1F"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#292C33"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F3F4F6"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#9297A3"/>

        <SolidColorBrush x:Key="AccentBrush"
                 Color="#8B6FF5"/>


        <!-- PasswordBox: stile locale, senza modificare gli altri controlli -->
        <Style x:Key="MasterPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#9B82FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsante principale -->
        <Style x:Key="PrimaryButton"
       TargetType="Button">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="Background"
            Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="FontSize"
            Value="15"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Padding"
            Value="20,12"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#9B82FF"/>

                            </Trigger>


                            <!-- PREMUTO -->

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#7659DD"/>

                            </Trigger>


                            <!-- DISABILITATO -->

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Pulsante secondario -->
        <Style x:Key="SecondaryButton"
       TargetType="Button"
       BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background"
            Value="#22252C"/>

            <Setter Property="Foreground"
            Value="#E5E7EB"/>

        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- CONTENUTO PRINCIPALE -->

        <Grid Grid.Row="0">

            <Border Width="430"
                    Padding="45"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <!-- Logo -->

                    <Border Width="70"
                            Height="70"
                            CornerRadius="18"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,22">

                        <TextBlock Text="🔐"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <!-- Titolo -->

                    <TextBlock Text="GDRVault"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Password Manager"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,35"/>


                    <!-- Password -->

                    <TextBlock Text="Master Password"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="MasterPasswordBox"
                                 Style="{StaticResource MasterPasswordStyle}"/>


                    <!-- Sblocca -->

                    <Button Content="Sblocca"
                            Style="{StaticResource PrimaryButton}"
                            Height="48"
                            Margin="0,18,0,0"
                            Click="UnlockButton_Click"/>


                    <!-- Separatore -->

                    <Grid Margin="0,25,0,20">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="1"
                                Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="oppure"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="12,0"/>

                        <Border Grid.Column="2"
                                Height="1"
                                Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Center"/>

                    </Grid>


                    <!-- Nuovo Vault -->

                    <Button Content="Crea nuovo Vault"
                            Style="{StaticResource SecondaryButton}"
                            Height="48"
                            Click="CreateVaultButton_Click"/>


                    <!-- Informazione -->

                    <TextBlock Text="🔒  I tuoi dati vengono protetti localmente"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,28,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- FOOTER -->

        <TextBlock Grid.Row="1"
                   Text="GDRVault • Secure Password Manager"
                   Foreground="#5F6470"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

    </Grid>

</Window>