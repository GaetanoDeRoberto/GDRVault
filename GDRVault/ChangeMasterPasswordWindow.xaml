<Window x:Class="GDRVault.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambia Master Password"
        Width="560"
        Height="590"
        MinWidth="560"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#101114">

    <Window.Resources>

        <!-- PULSANTE PRINCIPALE VIOLA -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B6CF0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#9B82FF"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#7355D6"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- PULSANTE SECONDARIO -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#242832"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#353944"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2D3039"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#4A4F5C"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1B1E24"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- CAMPI PASSWORD -->
        <Style x:Key="MasterPasswordBoxStyle" TargetType="PasswordBox">

            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="SelectionBrush" Value="#FF8B6CF0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBorder"
                                        Property="BorderBrush"
                                        Value="#8B6CF0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Margin="25">

        <Border Background="#191B20"
                CornerRadius="18"
                Padding="30">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- TITOLO -->
                <TextBlock Grid.Row="0"
                           Text="Cambia Master Password"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="White"/>


                <!-- DESCRIZIONE -->
                <TextBlock Grid.Row="2"
                           Text="Inserisci la password attuale e scegli una nuova Master Password."
                           Foreground="#9FA4B2"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22"/>


                <!-- PASSWORD ATTUALE -->
                <StackPanel Grid.Row="3"
                            Margin="0,0,0,16">
                    
                    
                    <TextBlock Text="Master Password attuale"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <PasswordBox x:Name="CurrentPasswordBox"
                                   Style="{StaticResource MasterPasswordBoxStyle}"/>
                </StackPanel>


                <!-- NUOVA PASSWORD -->
                <StackPanel Grid.Row="4"
                            Margin="0,0,0,16">

                    <TextBlock Text="Nuova Master Password"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <PasswordBox x:Name="NewPasswordBox"
                                 Style="{StaticResource MasterPasswordBoxStyle}"/>
                    

                    <TextBlock Text="Minimo 12 caratteri"
                               Foreground="#858A98"
                               FontSize="12"
                               Margin="2,6,0,0"/>

                </StackPanel>


                <!-- CONFERMA + PULSANTI -->
                <Grid Grid.Row="5"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Conferma nuova Master Password"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource MasterPasswordBoxStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- PULSANTI -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Annulla"
                            Width="110"
                            Height="48"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Content="Cambia password"
                            Width="155"
                            Height="48"
                            Click="ChangeButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>

</Window>
