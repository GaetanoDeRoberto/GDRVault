<Window x:Class="GDRVault.EntryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dettaglio credenziale"
        Width="620"
        Height="720"
        MinWidth="620"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#101114">


    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B6CF0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#9B82FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#7355D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#242832"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#353944"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#2D3039"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush" Value="#4A4F5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#1B1E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="CaretBrush" Value="#8B6CF0"/>
            <Setter Property="SelectionBrush" Value="#8B6CF0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#8B6CF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="CaretBrush" Value="#8B6CF0"/>
            <Setter Property="SelectionBrush" Value="#8B6CF0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBoxBorder" Property="BorderBrush" Value="#8B6CF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBoxBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#191B20"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

            <Style x:Key="EntryDetailsActionButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#8B6CF0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#9B82FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#7355D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>


    <Grid Margin="25">
        <Border Background="#191B20"
                CornerRadius="18"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button x:Name="FavoriteButton"
                            Grid.Column="1"
                            Content="☆"
                            Width="52"
                            Height="45"
                            FontSize="26"
                            Foreground="#CFC4FF"
                            Click="FavoriteButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Username / Email" 
                               Foreground="White"
                               FontWeight="SemiBold" 
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameBox" 
                                 Height="48" 
                                 IsReadOnly="True"/>
                        <Button Grid.Column="1" 
                                Content="Copia"
                                Width="82" 
                                Height="48" 
                                Margin="8,0,0,0"
                                Click="CopyUsernameButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" 
                            Margin="0,0,0,16">
                    <TextBlock Text="Password" 
                               Foreground="White"
                               FontWeight="SemiBold" 
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="PasswordBox" 
                                         Height="48"/>
                            <TextBox x:Name="VisiblePasswordBox"
                                     Height="48"
                                     Visibility="Collapsed"
                                     IsReadOnly="True"/>
                        </Grid>
                        <Button x:Name="ShowPasswordButton"
                                Grid.Column="1" Content="Mostra"
                                Width="82" Height="48" Margin="8,0,0,0"
                                Click="ShowPasswordButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="Copia"
                                Width="82" Height="48" Margin="8,0,0,0"
                                Click="CopyPasswordButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,16">
                    <TextBlock Text="URL" Foreground="White"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlBox" 
                                 Height="48" 
                                 IsReadOnly="True"/>
                        <Button Grid.Column="1" 
                                Content="Apri"
                                Width="82" 
                                Height="48" 
                                Margin="8,0,0,0"
                                Click="OpenUrlButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,16">
                    <TextBlock Text="Categoria" 
                               Foreground="White"
                               FontWeight="SemiBold" 
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="CategoryBox"
                             Height="48"
                             IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Grid.Row="6" VerticalAlignment="Top">
                    <TextBlock Text="Note" Foreground="White"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="NotesBox"
                             Height="80"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <Grid Grid.Row="7" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Elimina"
                            Width="100" Height="42"
                            HorizontalAlignment="Left"
                            Click="DeleteButton_Click"
                            Style="{StaticResource EntryDetailsActionButton}"/>
                    <Button Grid.Column="1" Content="Modifica"
                            Width="100" Height="42" Margin="8,0,0,0"
                            Click="EditButton_Click"
                            Style="{StaticResource EntryDetailsActionButton}"/>
                    <Button Grid.Column="2" Content="Salva"
                            Width="100" Height="42" Margin="8,0,0,0"
                            Click="SaveButton_Click"
                            Style="{StaticResource EntryDetailsActionButton}"/>
                    <Button Grid.Column="3" Content="Chiudi"
                            Width="100" Height="42" Margin="8,0,0,0"
                            Click="CloseButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
