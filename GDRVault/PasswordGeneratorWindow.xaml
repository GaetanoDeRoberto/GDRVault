<Window x:Class="GDRVault.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generatore password"
        Width="520"
        Height="530"
        MinWidth="520"
        MinHeight="530"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#101114">


    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B6CF0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#9B82FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#7355D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#242832"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#353944"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#2D3039"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush" Value="#4A4F5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#1B1E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="SelectionBrush" Value="#FF8B6CF0"/>
            <Setter Property="CaretBrush" Value="#FF8B6CF0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#8B6CF0"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#101114"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="11"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#191B20"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

    </Window.Resources>


    <Grid Margin="25">
        <Border Background="#191B20"
                CornerRadius="18"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Generatore password"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="White"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lunghezza"
                               Foreground="White"
                               FontSize="15"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="LengthBox"
                             Grid.Column="1"
                             Text="20"
                             Height="48"
                             HorizontalContentAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Caratteri da utilizzare"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="LowercaseCheckBox"
                              Content="Lettere minuscole"
                              IsChecked="True"/>
                    <CheckBox x:Name="UppercaseCheckBox"
                              Content="Lettere maiuscole"
                              IsChecked="True"/>
                    <CheckBox x:Name="NumbersCheckBox"
                              Content="Numeri"
                              IsChecked="True"/>
                    <CheckBox x:Name="SymbolsCheckBox"
                              Content="Simboli"
                              IsChecked="True"/>
                </StackPanel>

                <Border Grid.Row="5"
                        Background="#101114"
                        BorderBrush="#30333D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,18,0,18"
                        VerticalAlignment="Center">
                    <TextBox x:Name="GeneratedPasswordBox"
                             Height="48"
                             TextWrapping="Wrap"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="17"
                             IsReadOnly="True"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Rigenera"
                            Width="100" Height="48"
                            Margin="0,0,10,0"
                            Click="RegenerateButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Annulla"
                            Width="100" Height="48"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Usa password"
                            Width="125" Height="48"
                            Click="UsePasswordButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
